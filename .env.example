# Nusxa oling: cp .env.example .env  (.env gitga tushmaydi)

# BotFather'dan olingan token. Faqat shu faylga yozing, chatga yoki gitga emas.
BOT_TOKEN=
# Kontent kanali (bot unda administrator bo'lishi kerak)
CONTENT_CHANNEL=@testislomyolida

# Lokal rivojlanish: docker compose up -d postgres redis
DATABASE_URL=postgresql+asyncpg://ilmbot:ilmbot@localhost:5432/ilmbot
REDIS_URL=redis://localhost:6379/0
TIMEZONE=Asia/Tashkent

# Admin panel (Bosqich 2). Xesh: python -m ilmbot.cli hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Uzun tasodifiy qator: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Bot ichidagi admin buyruqlari (/stats, /broadcast) uchun Telegram ID lar, vergul bilan. ID ni botdagi /myid beradi
ADMINS=

# Telegram umumiy limiti ~30 xabar/s; worker shundan ozini oladi
SEND_RATE_PER_SEC=25
BROADCAST_RATE_PER_SEC=10
LOG_LEVEL=INFO
